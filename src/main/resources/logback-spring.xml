<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logs a consola (Docker/Coolify los recolectan). Cada línea lleva requestId y hotel del MDC.
  Regla del proyecto: nunca registrar contraseñas, tokens, credenciales, datos de tarjeta ni cuerpos de request.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %5p [%X{requestId:-}] [h:%X{hotel:-}] %-40.40logger{39} : %m%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
