# Variables de entorno del backend. Copia este archivo a .env (ignorado por git) para desarrollo local,
# o defínelas en Coolify > Environment Variables en producción. NUNCA subas valores reales.
# Genera secretos con:  openssl rand -base64 48

# --- Perfil: dev por defecto. En producción define SPRING_PROFILES_ACTIVE=prod como variable de entorno real ---

# --- Base de datos ---
DB_URL=jdbc:postgresql://localhost:5432/nexora_hotel
DB_USERNAME=postgres
DB_PASSWORD=

# --- Seguridad (obligatorias; mínimo 32 caracteres, distintas entre sí) ---
APP_JWT_SECRET=
APP_ENCRYPTION_KEY=
# En producción con frontend y backend en dominios distintos: true + None (requiere HTTPS)
APP_COOKIE_SECURE=false
APP_COOKIE_SAMESITE=Lax

# --- URLs ---
APP_FRONTEND_URL=http://localhost:5180
APP_PUBLIC_URL=http://localhost:8090
APP_CORS_ALLOWED_ORIGINS=http://localhost:5180

# --- Archivos subidos: en producción ruta ABSOLUTA de un volumen persistente (ej. /data/storage) ---
APP_STORAGE_DIR=./data/storage

# --- Opcionales ---
# SERVER_PORT=8090
# APP_JWT_ACCESS_TTL=PT20M
# APP_JWT_REFRESH_TTL=PT10H
# APP_STORAGE_MAX_IMAGE_BYTES=8388608

# --- Alta inicial del SUPER_ADMIN (solo si no existe ninguno; bórralas después del primer arranque) ---
APP_BOOTSTRAP_SUPER_ADMIN_EMAIL=
APP_BOOTSTRAP_SUPER_ADMIN_PASSWORD=
# --- Solo perfil dev: crea el hotel demo "gran-hotel-nexora" con admin y recepcionista ---
APP_DEMO_DATA=false
APP_DEMO_PASSWORD=
# --- SMTP de plataforma (recuperación de contraseña). Sin host, en dev el enlace va al log ---
# MAIL_HOST=
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=no-reply@tu-dominio.mx
